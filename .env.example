# Copie este arquivo para ".env" e preencha. O .env não vai para o GitHub.

# PIN do painel da atendente. Troque em produção.
ATENDENTE_PIN=1234

# ---- Banco no TiDB Cloud (serve para o computador e para a Vercel) ----
# Dados em: TiDB Cloud > seu cluster > Connect.
DB_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=PREFIXO.root
DB_PASSWORD=
DB_NAME=cantina_escola
DB_SSL=true

# ---- Ou: MySQL no seu computador (o mesmo do MySQL Workbench) ----
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=cantina_escola
# (sem DB_SSL)
